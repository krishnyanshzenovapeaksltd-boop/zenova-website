<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Omnichannel Automation Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0b1329; color: #ffffff; font-family: sans-serif; }
        .card-box { background: linear-gradient(145deg, #111c38, #0f172a); border: 1px solid rgba(212, 175, 55, 0.3); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen p-6 md:p-10 flex flex-col justify-between">

    <header class="max-w-5xl mx-auto w-full flex justify-between items-center border-b border-blue-950 pb-6 mb-8">
        <div>
            <h1 class="text-xl font-bold gold-text">🤖 CLIENT OMNICHANNEL BOT PORTAL</h1>
            <p class="text-xs text-gray-400">Connected to Facebook, Instagram & WhatsApp</p>
        </div>
        <a href="/" class="text-xs bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg font-bold transition">🌐 Home</a>
    </header>

    <main class="max-w-5xl mx-auto w-full space-y-8">
        
        <!-- COMPANY TRAINING FORM FOR BOT -->
        <div class="card-box p-6 rounded-2xl">
            <h2 class="text-lg font-bold gold-text mb-2">🧠 Train Your AI Bot</h2>
            <p class="text-xs text-gray-300 mb-6">Enter your company details below so the omnichannel bot knows how to reply to your customers on Facebook, Instagram, and WhatsApp.</p>
            
            <form onsubmit="saveBotConfig(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block text-gray-300 mb-1">Your Business Name</label>
                    <input type="text" id="bName" required class="w-full bg-[#0b1329] border border-blue-900 p-3 rounded-xl text-white outline-none focus:border-amber-400" placeholder="e.g. John Enterprises">
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">What your business offers & pricing details</label>
                    <textarea id="bDetails" rows="3" required class="w-full bg-[#0b1329] border border-blue-900 p-3 rounded-xl text-white outline-none focus:border-amber-400" placeholder="Describe your products/services so bot can answer queries..."></textarea>
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">Connect Channels</label>
                    <div class="flex gap-4 text-gray-300 pt-1">
                        <label><input type="checkbox" checked> Facebook Messenger</label>
                        <label><input type="checkbox" checked> Instagram DM</label>
                        <label><input type="checkbox" checked> WhatsApp Business</label>
                    </div>
                </div>
                <button type="submit" class="bg-amber-400 hover:bg-amber-500 text-black font-bold px-6 py-3 rounded-xl transition text-xs">
                    💾 Save & Activate Omnichannel Bot
                </button>
            </form>
            <p id="botSavedMsg" class="hidden text-green-400 text-xs mt-3">✔ Bot successfully trained and deployed across Facebook, Instagram & WhatsApp!</p>
        </div>

    </main>

    <footer class="max-w-5xl mx-auto w-full text-center text-xs text-gray-500 border-t border-blue-950 pt-6 mt-10">
        <p>Krishnyansh Zenova Peak Tech Hub • Omnichannel Engine</p>
    </footer>

    <script>
        function saveBotConfig(e) {
            e.preventDefault();
            document.getElementById('botSavedMsg').classList.remove('hidden');
        }
    </script>
</body>
</html>
