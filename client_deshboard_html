<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Automation & Invoice Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0b1329; color: #ffffff; font-family: sans-serif; }
        .card-box { background: linear-gradient(145deg, #111c38, #0f172a); border: 1px solid rgba(212, 175, 55, 0.3); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen p-6 md:p-10 flex flex-col justify-between">

    <header class="max-w-5xl mx-auto w-full flex justify-between items-center border-b border-blue-950 pb-6 mb-8">
        <div>
            <h1 class="text-xl font-bold gold-text">⚡ CLIENT AUTOMATION & INVOICE PORTAL</h1>
            <p class="text-xs text-gray-400">FB, Insta, WhatsApp Omnichannel & Invoice Generator</p>
        </div>
        <a href="/" class="text-xs bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg font-bold transition">🌐 Home</a>
    </header>

    <main class="max-w-5xl mx-auto w-full space-y-8">
        
        <!-- OMNICHANNEL BOT TRAINING FORM -->
        <div class="card-box p-6 rounded-2xl">
            <h2 class="text-lg font-bold gold-text mb-2">🤖 Omnichannel AI Bot Setup</h2>
            <p class="text-xs text-gray-300 mb-4">Connect your company info so the bot can auto-reply across Facebook, Instagram, and WhatsApp.</p>
            
            <form onsubmit="saveBotConfig(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block text-gray-300 mb-1">Company / Business Name</label>
                    <input type="text" id="cbName" required class="w-full bg-[#0b1329] border border-blue-900 p-3 rounded-xl text-white outline-none focus:border-amber-400" placeholder="e.g. My Enterprise">
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">Services & Pricing Details for Bot</label>
                    <textarea id="cbDetails" rows="3" required class="w-full bg-[#0b1329] border border-blue-900 p-3 rounded-xl text-white outline-none focus:border-amber-400" placeholder="Provide info so bot answers customer chats accurately..."></textarea>
                </div>
                <div class="flex gap-4 text-gray-300 pt-1">
                    <label><input type="checkbox" checked> Facebook Messenger</label>
                    <label><input type="checkbox" checked> Instagram DM</label>
                    <label><input type="checkbox" checked> WhatsApp Business</label>
                </div>
                <button type="submit" class="bg-amber-400 hover:bg-amber-500 text-black font-bold px-6 py-2.5 rounded-xl transition">
                    Save & Deploy Bot
                </button>
            </form>
            <p id="botMsg" class="hidden text-green-400 text-xs mt-3">✔ Bot successfully deployed across FB, Insta, and WhatsApp!</p>
        </div>

        <!-- EDITABLE INVOICE GENERATOR -->
        <div class="card-box p-6 rounded-2xl">
            <h2 class="text-lg font-bold gold-text mb-4">📄 Auto-Generate Editable Invoice</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 text-xs">
                <div>
                    <label class="block text-gray-300 mb-1">Client Name</label>
                    <input type="text" id="invClient" value="John Doe Enterprises" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-white">
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">Phone Number</label>
                    <input type="text" id="invPhone" value="+234..." class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-white">
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">Service Description</label>
                    <input type="text" id="invService" value="AltraAI Premium Setup + Maintenance" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-white">
                </div>
                <div>
                    <label class="block text-gray-300 mb-1">Amount (₦)</label>
                    <input type="text" id="invAmount" value="₦100,000" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-white">
                </div>
            </div>

            <!-- INVOICE PREVIEW -->
            <div id="invoicePreview" class="bg-white text-black p-6 rounded-xl mb-4 font-sans text-xs">
                <div class="flex justify-between border-b pb-4 mb-4">
                    <div>
                        <h3 class="font-extrabold text-sm text-blue-900">KRISHNYANSH ZENOVA PEAK TECH HUB</h3>
                        <p class="text-[10px] text-gray-600">Trading as ZENOVA PEAK TECH HUB • BN 9701468</p>
                    </div>
                    <div class="text-right">
                        <p class="font-bold text-xs">INVOICE NO: ZENOVA-001</p>
                        <p class="text-[10px] text-gray-600">Date: Today</p>
                    </div>
                </div>
                <div class="mb-4">
                    <p><strong>Client Name:</strong> <span id="prevClient">John Doe Enterprises</span></p>
                    <p><strong>Phone:</strong> <span id="prevPhone">+234...</span></p>
                </div>
                <div class="border-t border-b py-2 mb-4">
                    <div class="flex justify-between font-bold text-gray-700 mb-1">
                        <span>Description</span>
                        <span>Amount</span>
                    </div>
                    <div class="flex justify-between">
                        <span id="prevService">AltraAI Premium Setup + Maintenance</span>
                        <span id="prevAmount" class="font-bold text-blue-900">₦100,000</span>
                    </div>
                </div>
                <div class="text-[10px] text-gray-600">
                    <p><strong>Payment Info:</strong> Zenith Bank | Acc: 2218237759 | Name: Ruby Garg</p>
                </div>
            </div>

            <button onclick="window.print()" class="bg-amber-400 hover:bg-amber-500 text-black font-bold px-6 py-2.5 rounded-xl text-xs transition">
                🖨️ Print / Download Invoice PDF
            </button>
        </div>

    </main>

    <footer class="max-w-5xl mx-auto w-full text-center text-xs text-gray-500 border-t border-blue-950 pt-6 mt-10">
        <p>Krishnyansh Zenova Peak Tech Hub • Client Suite</p>
    </footer>

    <script>
        function saveBotConfig(e) {
            e.preventDefault();
            document.getElementById('botMsg').classList.remove('hidden');
        }
        document.getElementById('invClient').oninput = function() { document.getElementById('prevClient').innerText = this.value; }
        document.getElementById('invPhone').oninput = function() { document.getElementById('prevPhone').innerText = this.value; }
        document.getElementById('invService').oninput = function() { document.getElementById('prevService').innerText = this.value; }
        document.getElementById('invAmount').oninput = function() { document.getElementById('prevAmount').innerText = this.value; }
    </script>
</body>
</html>
