<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Automation & Invoice Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0b1329; color: #ffffff; font-family: sans-serif; }
        .card-box { background: linear-gradient(145deg, #111c38, #0f172a); border: 1px solid rgba(212, 175, 55, 0.3); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen p-6 md:p-10 flex flex-col justify-between">

    <header class="max-w-5xl mx-auto w-full flex justify-between items-center border-b border-blue-950 pb-6 mb-8">
        <div>
            <h1 class="text-xl font-bold gold-text">⚡ CLIENT AUTOMATION PORTAL</h1>
            <p class="text-xs text-gray-400">Krishnyansh Zenova Peak Tech Hub (BN 9701468)</p>
        </div>
        <a href="/" class="text-xs bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg font-bold transition">🌐 Home</a>
    </header>

    <main class="max-w-5xl mx-auto w-full space-y-8">
        
        <div class="card-box p-6 rounded-2xl border-amber-400/50">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-blue-900 pb-4 mb-4">
                <div>
                    <h2 class="text-lg font-bold gold-text">🚀 SaaS Automation Suite License</h2>
                    <p class="text-xs text-gray-300 mt-1">Unlock Full Auto-Mode for WhatsApp, Instagram, Facebook, and LinkedIn.</p>
                </div>
                <div class="bg-amber-400/10 border border-amber-400/40 px-4 py-2 rounded-xl text-right">
                    <p class="text-xs text-amber-300 font-semibold">Pricing Structure:</p>
                    <p class="text-sm font-extrabold gold-text">₦85,000 <span class="text-[10px] text-gray-300 font-normal">One-time</span> + ₦15,000<span class="text-[10px] text-gray-300 font-normal">/mo</span></p>
                </div>
            </div>

            <div class="bg-[#0b1329] border border-blue-900 p-5 rounded-xl">
                <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-3">🏦 Direct Bank Transfer Details (Manual Payment)</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs mb-4 text-gray-300">
                    <div>
                        <p class="text-gray-500">Bank Name:</p>
                        <p class="font-bold text-white">Zenith / Wema Bank</p>
                    </div>
                    <div>
                        <p class="text-gray-500">Account Name:</p>
                        <p class="font-bold text-white">Zenova Peak Tech Hub</p>
                    </div>
                    <div>
                        <p class="text-gray-500">Account Number:</p>
                        <p class="font-bold text-amber-300 font-mono text-sm">Pending Business Account</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-blue-950">
                    <input type="text" placeholder="Enter Teller / Transfer Reference No." class="bg-[#111c38] border border-blue-900 px-3 py-2 rounded-lg text-xs text-white outline-none focus:border-amber-400 flex-1">
                    <button onclick="alert('Payment receipt submitted successfully! Verification takes 1-2 hours.')" class="bg-amber-400 hover:bg-amber-500 text-black font-bold px-5 py-2 rounded-lg text-xs transition">
                        I Have Made Transfer
                    </button>
                </div>
            </div>
        </div>

        <div class="card-box p-6 rounded-2xl">
            <h2 class="text-lg font-bold gold-text mb-4">🔗 Social Channels Auto-Mode Control</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-[#0b1329] border border-blue-900 p-4 rounded-xl flex justify-between items-center">
                    <span class="text-xs font-bold">💬 WhatsApp Bot</span>
                    <button onclick="toggleAuto(this)" class="bg-green-600 text-white text-[10px] px-3 py-1 rounded font-bold">ACTIVE</button>
                </div>
                <div class="bg-[#0b1329] border border-blue-900 p-4 rounded-xl flex justify-between items-center">
                    <span class="text-xs font-bold">📸 Instagram Auto</span>
                    <button onclick="toggleAuto(this)" class="bg-green-600 text-white text-[10px] px-3 py-1 rounded font-bold">ACTIVE</button>
                </div>
                <div class="bg-[#0b1329] border border-blue-900 p-4 rounded-xl flex justify-between items-center">
                    <span class="text-xs font-bold">📘 Facebook Auto</span>
                    <button onclick="toggleAuto(this)" class="bg-green-600 text-white text-[10px] px-3 py-1 rounded font-bold">ACTIVE</button>
                </div>
                <div class="bg-[#0b1329] border border-blue-900 p-4 rounded-xl flex justify-between items-center">
                    <span class="text-xs font-bold">💼 LinkedIn Sync</span>
                    <button onclick="toggleAuto(this)" class="bg-green-600 text-white text-[10px] px-3 py-1 rounded font-bold">ACTIVE</button>
                </div>
            </div>
        </div>

        <div class="card-box p-6 rounded-2xl">
            <h2 class="text-lg font-bold gold-text mb-4">📄 Auto-Generate Editable Invoice</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs text-gray-300 mb-1">Client Name</label>
                    <input type="text" id="invClient" value="John Doe Enterprises" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-xs text-white">
                </div>
                <div>
                    <label class="block text-xs text-gray-300 mb-1">Service Description</label>
                    <input type="text" id="invService" value="SaaS Automation Setup (₦85k) + Maintenance (₦15k)" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-xs text-white">
                </div>
                <div>
                    <label class="block text-xs text-gray-300 mb-1">Amount (₦)</label>
                    <input type="text" id="invAmount" value="₦100,000" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-xs text-white">
                </div>
                <div>
                    <label class="block text-xs text-gray-300 mb-1">Due Date</label>
                    <input type="text" id="invDate" value="Immediate" class="w-full bg-[#0b1329] border border-blue-900 p-2.5 rounded-xl text-xs text-white">
                </div>
            </div>

            <div id="invoicePreview" class="bg-white text-black p-6 rounded-xl mb-4 font-sans">
                <div class="flex justify-between border-b pb-4 mb-4">
                    <div>
                        <h3 class="font-extrabold text-sm text-blue-900">KRISHNYANSH ZENOVA PEAK TECH HUB</h3>
                        <p class="text-[10px] text-gray-600">BN 9701468 • Nigeria</p>
                    </div>
                    <div class="text-right">
                        <p class="font-bold text-xs">INVOICE</p>
                        <p class="text-[10px] text-gray-600">Date: Today</p>
                    </div>
                </div>
                <div class="text-xs mb-4">
                    <p><strong>Billed To:</strong> <span id="prevClient">John Doe Enterprises</span></p>
                    <p><strong>Service:</strong> <span id="prevService">SaaS Automation Setup + Maintenance</span></p>
                </div>
                <div class="flex justify-between font-bold text-xs border-t pt-2">
                    <span>Total Amount:</span>
                    <span id="prevAmount" class="text-blue-900">₦100,000</span>
                </div>
            </div>

            <button onclick="generateInvoice()" class="bg-amber-400 hover:bg-amber-500 text-black font-bold px-6 py-2.5 rounded-xl text-xs transition">
                🖨️ Print / Download Invoice
            </button>
        </div>

    </main>

    <footer class="max-w-5xl mx-auto w-full text-center text-xs text-gray-500 border-t border-blue-950 pt-6 mt-10">
        <p>Krishnyansh Zenova Peak Tech Hub • Client Automation Suite</p>
    </footer>

    <script>
        function toggleAuto(btn) {
            if(btn.innerText === "ACTIVE") {
                btn.innerText = "PAUSED";
                btn.className = "bg-red-600 text-white text-[10px] px-3 py-1 rounded font-bold";
            } else {
                btn.innerText = "ACTIVE";
                btn.className = "bg-green-600 text-white text-[10px] px-3 py-1 rounded font-bold";
            }
        }

        function generateInvoice() {
            document.getElementById('prevClient').innerText = document.getElementById('invClient').value;
            document.getElementById('prevService').innerText = document.getElementById('invService').value;
            document.getElementById('prevAmount').innerText = document.getElementById('invAmount').value;
            window.print();
        }
    </script>
</body>
</html>
